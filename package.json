{
  "name": "pulsecare-ihms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "check:shifts": "node --experimental-strip-types scripts/check-shift-attendance.mjs",
    "check:attendance-sql": "node scripts/check-attendance-sql.mjs",
    "check:dates": "node --experimental-strip-types scripts/check-hospital-date.mjs",
    "check:smoke": "npm run check:shifts && npm run check:dates && npm run check:attendance-ui && node --experimental-strip-types scripts/check-attendance-display.mjs && node scripts/check-migration-versions.mjs && npm run check:attendance-sql && npm run check:login && npm run check:auth-realtime && npm run check:routes && npm run check:security && npm run check:ui-feedback && node scripts/check-atomic-shift-and-email.mjs && node --experimental-strip-types scripts/check-appointment-sorting.mjs && node scripts/check-public-branding.mjs",
    "check:attendance-ui": "node scripts/check-attendance-ui.mjs",
    "check:login": "node --experimental-strip-types scripts/check-login.mjs",
    "check:auth-realtime": "node scripts/check-auth-realtime.mjs && node --experimental-strip-types scripts/check-tab-session-runtime.mjs",
    "check:routes": "node --experimental-strip-types scripts/check-workspace-routes.mjs",
    "check:security": "node scripts/check-security-contracts.mjs",
    "check:ui-feedback": "node scripts/check-ui-feedback.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
