# Public Supabase project values. The anon key is safe to expose only when
# Row Level Security is enabled for every table.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side only: required by Vercel staff management and mobile-number login APIs.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Keep service-role keys server-side; never use VITE_.

# Server-side only: Gmail SMTP for patient appointment confirmations.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="YOUR_GMAIL_ADDRESS"
SMTP_PASS="YOUR_GOOGLE_APP_PASSWORD"
SMTP_FROM_NAME="Integrated Hospital Management System"
SMTP_FROM_EMAIL="YOUR_GMAIL_ADDRESS"

# Optional public values shown on printed prescription slips. Only set verified details.
# These VITE_ values are bundled into the public client; never place secrets here.
VITE_HOSPITAL_REGISTRATION_NUMBER=""
VITE_HOSPITAL_HELPLINE=""

# Optional server-only emergency contact returned by GET /api/hospital.
# Configure only a verified, actively monitored hospital number.
HOSPITAL_EMERGENCY_CONTACT=""
